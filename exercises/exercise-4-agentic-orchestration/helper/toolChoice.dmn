<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1xu2zql" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.43.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <decision id="Decision_toolUse" name="Decide on Tools">
    <decisionTable id="DecisionTable_0v9u2st">
      <input id="Input_1" label="Customer Message">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Tools" name="toolChoice" typeRef="string" />
      <rule id="DecisionRule_1vud4p6">
        <inputEntry id="UnaryTests_0k2ij2m">
          <text>contains(lower-case(customerMessage), "tire")</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0nn2ql6">
          <text>"Tool_4"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0ahfn39">
        <inputEntry id="UnaryTests_09hjdu5">
          <text>contains(lower-case(customerMessage), "chain")</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_15fayjn">
          <text>"Tool_5"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0gt1rky">
        <inputEntry id="UnaryTests_0rz7jg7">
          <text> contains(lower-case(customerMessage), "light")</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_12rmqwd">
          <text>"Tool_2,Tool_6"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1ka4t4n">
        <inputEntry id="UnaryTests_09xbv3p">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0rxjtvp">
          <text>"Tool_5"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape id="Decision_0mvw1gh_di" dmnElementRef="Decision_toolUse">
        <dc:Bounds height="80" width="180" x="160" y="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
