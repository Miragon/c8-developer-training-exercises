    <bpmn:sequenceFlow id="Flow_0acrdq1" sourceRef="Activity_1ws6a1f" targetRef="Activity_19pjnlb" />
    <bpmn:sequenceFlow id="Flow_1d7ctj9" sourceRef="Activity_19pjnlb" targetRef="Gateway_0b07diz" />
    <bpmn:sequenceFlow id="Flow_1axnb5n" sourceRef="Gateway_0b07diz" targetRef="Event_15nao8x" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1l97jvw">
      <bpmndi:BPMNShape id="Participant_0dt7tvu_di" bpmnElement="Participant_customerSupport" isHorizontal="true">
