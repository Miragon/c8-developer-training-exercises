<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1cn3qg5" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.43.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1l97jvw">
    <bpmn:participant id="Participant_customerSupport" name="Miravelo Customer Support Process" processRef="Process_CustomerSupport" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CustomerSupport" name="Miravelo Customer Support Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Support Request received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=customerNo" target="customerNo" />
          <zeebe:output source="=orderId" target="orderId" />
          <zeebe:output source="=customerMessage" target="customerMessage" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_14cpm2d</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_12uelcr" name="Decide on Tool to use" zeebe:modelerTemplate="io.camunda.connectors.OpenAI.v1" zeebe:modelerTemplateVersion="6" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input target="authentication.token" />
          <zeebe:input source="=if is defined(internal_organization) and internal_organization != null then {&#34;Content-Type&#34;:&#34;application/json&#34;, &#34;OpenAI-Organization&#34;:internal_organization} else {&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="chat" target="operation" />
          <zeebe:input source="post" target="method" />
          <zeebe:input source="https://api.openai.com/v1/chat/completions" target="url" />
          <zeebe:input source="gpt-4o" target="internal_model" />
          <zeebe:input source="1" target="internal_temperature" />
          <zeebe:input source="We received a support request from one of our customers. We are Miravelo a bike Company, selling high quality products. We want to be the best in service quality as well." target="internal_systemMessage" />
          <zeebe:input source="=&#34;Our customer &#34; + customerNo + &#34; with his orderId &#34; + orderId + &#34;contacted us with the following message: &#34; +customerMessage + &#34; We want to help him. Choose one of the following tools available for you. Stricly responde with Tool_1,..._2, .... You can also choose multiple at once. Seperate them striclty via a comma, do not leave any space. Tool_1: Get order status from logistics; Tool_2: Check inventory for replacement; Tool_3: Decide warranty eligibility; Tool_4: Draft customer reply; Tool_5: Ask human for approval; Tool_6: Create ticket for warehouse or support&#34;" target="internal_prompt" />
          <zeebe:input source="1" target="internal_choices" />
          <zeebe:input source="=append(concatenate(if is defined(internal_systemMessage) then [{&#34;role&#34;: &#34;system&#34;, &#34;content&#34;: internal_systemMessage}] else [], if is defined(internal_chatHistory) then internal_chatHistory else []), {&#34;role&#34;: &#34;user&#34;, &#34;content&#34;: internal_prompt})" target="internal_messages" />
          <zeebe:input source="={&#34;model&#34;: if is defined(internal_custom_model) then internal_custom_model else internal_model, &#34;messages&#34;: internal_messages, &#34;n&#34;: number(internal_choices), &#34;temperature&#34;: number(internal_temperature)}" target="body" />
          <zeebe:input source="30" target="connectionTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="toolChoice" />
          <zeebe:header key="resultExpression" value="={toolChoice: response.body.choices[1].message.content}" />
          <zeebe:header key="elementTemplateVersion" value="6" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.OpenAI.v1" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14cpm2d</bpmn:incoming>
      <bpmn:outgoing>Flow_11k6ax1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_1v1cyre" name="Prepare Todo&#39;s">
      <bpmn:extensionElements>
        <zeebe:script expression="=split(toolChoice, &#34;,&#34;)" resultVariable="toolList" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11k6ax1</bpmn:incoming>
      <bpmn:incoming>Flow_0br138x</bpmn:incoming>
      <bpmn:outgoing>Flow_1fljfph</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Activity_0g07tpr" name="Handle support case old-fashioned">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07a8l1d</bpmn:incoming>
      <bpmn:outgoing>Flow_0hz5id8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0gy812z" name="Support Case handled by human">
      <bpmn:incoming>Flow_0hz5id8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_19pjnlb" name="Decide if anything else needs to be done" zeebe:modelerTemplate="io.camunda.connectors.OpenAI.v1" zeebe:modelerTemplateVersion="6" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input target="authentication.token" />
          <zeebe:input source="=if is defined(internal_organization) and internal_organization != null then {&#34;Content-Type&#34;:&#34;application/json&#34;, &#34;OpenAI-Organization&#34;:internal_organization} else {&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="chat" target="operation" />
          <zeebe:input source="post" target="method" />
          <zeebe:input source="https://api.openai.com/v1/chat/completions" target="url" />
          <zeebe:input source="gpt-4o" target="internal_model" />
          <zeebe:input source="1" target="internal_temperature" />
          <zeebe:input source="We received a support request from one of our customers. We are Miravelo a bike Company, selling high quality products. We want to be the best in service quality as well." target="internal_systemMessage" />
          <zeebe:input source="={&#10;  safe: function(x) if x = null then &#34;&#34; else string(x),&#10;  txt:&#10;    &#34;Our customer &#34; + safe(customerNo)&#10;    + (if customerNo = null then &#34;&#34; else &#34; &#34;)&#10;    + (if orderId = null then &#34;&#34; else &#34;with his orderId &#34; + safe(orderId) + &#34; &#34;)&#10;    + &#34;contacted us with the following message: &#34; + safe(customerMessage)&#10;    + &#34;. We want to help him. We may need additional details now:&#34;&#10;    + (if orderStatus = null then &#34;&#34; else &#34; Order Status: &#34; + safe(orderStatus) + &#34;.&#34;)&#10;    + (if replacementAvailable = null then &#34;&#34; else &#34; Replacement available: &#34; + safe(replacementAvailable) + &#34;.&#34;)&#10;    + (if isEligableforWarranty = null then &#34;&#34; else &#34; Eligible for warranty: &#34; + safe(isEligableforWarranty) + &#34;.&#34;)&#10;    + (if ticketCreated = null then &#34;&#34; else &#34; Warehouse Ticket created: &#34; + safe(ticketCreated) + &#34;.&#34;)&#10;    + (if humanOpinion = null then &#34;&#34; else &#34; Human Opinion: &#34; + safe(humanOpinion) + &#34;.&#34;)&#10;    + &#34; Choose one of the following tools available for you. Stricly respond with Tool_1,..._2, .... You can also choose multiple at once. Separate them strictly via a comma, do not leave any space.&#34;&#10;    + &#34; Tool_1: Get order status from logistics; Tool_2: Check inventory for replacement; Tool_3: Decide warranty eligibility; Tool_4: Draft customer reply; Tool_5: Ask human for approval; Tool_6: Create ticket for warehouse or support.&#34;&#10;    + &#34; Return a blank body if you do not want to execute any of it.&#34;&#10;}.txt" target="internal_prompt" />
          <zeebe:input source="1" target="internal_choices" />
          <zeebe:input source="=append(concatenate(if is defined(internal_systemMessage) then [{&#34;role&#34;: &#34;system&#34;, &#34;content&#34;: internal_systemMessage}] else [], if is defined(internal_chatHistory) then internal_chatHistory else []), {&#34;role&#34;: &#34;user&#34;, &#34;content&#34;: internal_prompt})" target="internal_messages" />
          <zeebe:input source="={&#34;model&#34;: if is defined(internal_custom_model) then internal_custom_model else internal_model, &#34;messages&#34;: internal_messages, &#34;n&#34;: number(internal_choices), &#34;temperature&#34;: number(internal_temperature)}" target="body" />
          <zeebe:input source="30" target="connectionTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="retroToolChoice" />
          <zeebe:header key="resultExpression" value="={retroToolChoice: response.body}" />
          <zeebe:header key="elementTemplateVersion" value="6" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.OpenAI.v1" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0acrdq1</bpmn:incoming>
      <bpmn:outgoing>Flow_1d7ctj9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0b07diz" name="Anything else required?" default="Flow_1axnb5n">
      <bpmn:incoming>Flow_1d7ctj9</bpmn:incoming>
      <bpmn:outgoing>Flow_1axnb5n</bpmn:outgoing>
      <bpmn:outgoing>Flow_0br138x</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_15nao8x" name="Support Case handeled">
      <bpmn:incoming>Flow_1axnb5n</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:adHocSubProcess id="Activity_1ws6a1f">
      <bpmn:extensionElements>
        <zeebe:adHoc activeElementsCollection="=toolList" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1fljfph</bpmn:incoming>
      <bpmn:outgoing>Flow_0acrdq1</bpmn:outgoing>
      <bpmn:scriptTask id="Tool_1" name="Get Order Status">
        <bpmn:extensionElements>
          <zeebe:script expression="=[&#34;shipped&#34;, &#34;order received&#34;, &#34;being built&#34;][floor(random number() * 3) + 1]" resultVariable="orderStatus" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Tool_2" name="Check Inventory for Replacement">
        <bpmn:extensionElements>
          <zeebe:script expression="=random number() &#60; 0.5" resultVariable="replacementAvailable" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Tool_3" name="Check if eligible for Warranty">
        <bpmn:extensionElements>
          <zeebe:script expression="=random number() &#60; 0.5" resultVariable="isEligableforWarranty" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Tool_4" name="Draft customer reply" zeebe:modelerTemplate="io.camunda.connectors.OpenAI.v1" zeebe:modelerTemplateVersion="6" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="bearer" target="authentication.type" />
            <zeebe:input target="authentication.token" />
            <zeebe:input source="=if is defined(internal_organization) and internal_organization != null then {&#34;Content-Type&#34;:&#34;application/json&#34;, &#34;OpenAI-Organization&#34;:internal_organization} else {&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
            <zeebe:input source="chat" target="operation" />
            <zeebe:input source="post" target="method" />
            <zeebe:input source="https://api.openai.com/v1/chat/completions" target="url" />
            <zeebe:input source="gpt-4o" target="internal_model" />
            <zeebe:input source="1" target="internal_temperature" />
            <zeebe:input source="We received a support request from one of our customers. We are Miravelo a bike Company, selling high quality products. We want to be the best in service quality as well." target="internal_systemMessage" />
            <zeebe:input source="={&#10;  safe: function(x) if x = null then &#34;&#34; else string(x),&#10;  txt:&#10;    &#34;Our customer &#34; + safe(customerNo)&#10;    + (if customerNo = null then &#34;&#34; else &#34; &#34;)&#10;    + (if orderId = null then &#34;&#34; else &#34;with his orderId &#34; + safe(orderId) + &#34; &#34;)&#10;    + &#34;contacted us with the following message: &#34; + safe(customerMessage)&#10;    + &#34;. We want to help him. We may need additional details now:&#34;&#10;    + (if orderStatus = null then &#34;&#34; else &#34; Order Status: &#34; + safe(orderStatus) + &#34;.&#34;)&#10;    + (if replacementAvailable = null then &#34;&#34; else &#34; Replacement available: &#34; + safe(replacementAvailable) + &#34;.&#34;)&#10;    + (if isEligableforWarranty = null then &#34;&#34; else &#34; Eligible for warranty: &#34; + safe(isEligableforWarranty) + &#34;.&#34;)&#10;    + (if ticketCreated = null then &#34;&#34; else &#34; Warehouse Ticket created: &#34; + safe(ticketCreated) + &#34;.&#34;)&#10;    + (if humanOpinion = null then &#34;&#34; else &#34; Human Opinion: &#34; + safe(humanOpinion) + &#34;.&#34;)&#10;    + &#34; Draft him an email.&#34;&#10;}.txt" target="internal_prompt" />
            <zeebe:input source="1" target="internal_choices" />
            <zeebe:input source="=append(concatenate(if is defined(internal_systemMessage) then [{&#34;role&#34;: &#34;system&#34;, &#34;content&#34;: internal_systemMessage}] else [], if is defined(internal_chatHistory) then internal_chatHistory else []), {&#34;role&#34;: &#34;user&#34;, &#34;content&#34;: internal_prompt})" target="internal_messages" />
            <zeebe:input source="={&#34;model&#34;: if is defined(internal_custom_model) then internal_custom_model else internal_model, &#34;messages&#34;: internal_messages, &#34;n&#34;: number(internal_choices), &#34;temperature&#34;: number(internal_temperature)}" target="body" />
            <zeebe:input source="30" target="connectionTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultVariable" value="email" />
            <zeebe:header key="resultExpression" value="={email: response.body}" />
            <zeebe:header key="elementTemplateVersion" value="6" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.OpenAI.v1" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_1hpaehh</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0jqub2p" sourceRef="Tool_5" targetRef="Activity_1w2rclz" />
      <bpmn:serviceTask id="Tool_5" name="Generate proposed actions" zeebe:modelerTemplate="io.camunda.connectors.OpenAI.v1" zeebe:modelerTemplateVersion="6" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="bearer" target="authentication.type" />
            <zeebe:input target="authentication.token" />
            <zeebe:input source="=if is defined(internal_organization) and internal_organization != null then {&#34;Content-Type&#34;:&#34;application/json&#34;, &#34;OpenAI-Organization&#34;:internal_organization} else {&#34;Content-Type&#34;:&#34;application/json&#34;}" target="headers" />
            <zeebe:input source="chat" target="operation" />
            <zeebe:input source="post" target="method" />
            <zeebe:input source="https://api.openai.com/v1/chat/completions" target="url" />
            <zeebe:input source="gpt-4o" target="internal_model" />
            <zeebe:input source="1" target="internal_temperature" />
            <zeebe:input source="We received a support request from one of our customers. We are Miravelo a bike Company, selling high quality products. We want to be the best in service quality as well." target="internal_systemMessage" />
            <zeebe:input source="={&#10;  safe: function(x) if x = null then &#34;&#34; else string(x),&#10;  txt:&#10;    &#34;Our customer &#34; + safe(customerNo)&#10;    + (if customerNo = null then &#34;&#34; else &#34; &#34;)&#10;    + (if orderId = null then &#34;&#34; else &#34;with his orderId &#34; + safe(orderId) + &#34; &#34;)&#10;    + &#34;contacted us with the following message: &#34; + safe(customerMessage)&#10;    + &#34;. We want to help him. We may need additional details now:&#34;&#10;    + (if orderStatus = null then &#34;&#34; else &#34; Order Status: &#34; + safe(orderStatus) + &#34;.&#34;)&#10;    + (if replacementAvailable = null then &#34;&#34; else &#34; Replacement available: &#34; + safe(replacementAvailable) + &#34;.&#34;)&#10;    + (if isEligableforWarranty = null then &#34;&#34; else &#34; Eligible for warranty: &#34; + safe(isEligableforWarranty) + &#34;.&#34;)&#10;    + (if ticketCreated = null then &#34;&#34; else &#34; Warehouse Ticket created: &#34; + safe(ticketCreated) + &#34;.&#34;)&#10;    + (if humanOpinion = null then &#34;&#34; else &#34; Human Opinion: &#34; + safe(humanOpinion) + &#34;.&#34;)&#10;    + &#34; What do you want to propose to get a human opinion on?&#34;&#10;}.txt" target="internal_prompt" />
            <zeebe:input source="1" target="internal_choices" />
            <zeebe:input source="=append(concatenate(if is defined(internal_systemMessage) then [{&#34;role&#34;: &#34;system&#34;, &#34;content&#34;: internal_systemMessage}] else [], if is defined(internal_chatHistory) then internal_chatHistory else []), {&#34;role&#34;: &#34;user&#34;, &#34;content&#34;: internal_prompt})" target="internal_messages" />
            <zeebe:input source="={&#34;model&#34;: if is defined(internal_custom_model) then internal_custom_model else internal_model, &#34;messages&#34;: internal_messages, &#34;n&#34;: number(internal_choices), &#34;temperature&#34;: number(internal_temperature)}" target="body" />
            <zeebe:input source="30" target="connectionTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultVariable" value="proposedActions" />
            <zeebe:header key="resultExpression" value="={proposedActions: response.body}" />
            <zeebe:header key="elementTemplateVersion" value="6" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.OpenAI.v1" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_0jqub2p</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Activity_1w2rclz" name="Ask human">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="Form_HumanOpinion" />
          <zeebe:ioMapping>
            <zeebe:input target="InputVariable_248vj72" />
            <zeebe:output source="=proposedActions" target="proposedActions" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0jqub2p</bpmn:incoming>
      </bpmn:userTask>
      <bpmn:scriptTask id="Tool_6" name="Create ticket for warehouse">
        <bpmn:extensionElements>
          <zeebe:script expression="=true" resultVariable="ticketCreated" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_1hpaehh" sourceRef="Tool_4" targetRef="Activity_1x0d4ee" />
      <bpmn:sendTask id="Activity_1x0d4ee" name="Send reply to customer">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="sendMailWorker" />
          <zeebe:ioMapping>
            <zeebe:input source="=email" target="email" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1hpaehh</bpmn:incoming>
      </bpmn:sendTask>
    </bpmn:adHocSubProcess>
    <bpmn:boundaryEvent id="Event_0g6qce7" name="20 Minutes" attachedToRef="Activity_1ws6a1f">
      <bpmn:outgoing>Flow_07a8l1d</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_124pvtc">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_14cpm2d" sourceRef="StartEvent_1" targetRef="Activity_12uelcr" />
    <bpmn:sequenceFlow id="Flow_11k6ax1" sourceRef="Activity_12uelcr" targetRef="Activity_1v1cyre" />
    <bpmn:sequenceFlow id="Flow_0br138x" sourceRef="Gateway_0b07diz" targetRef="Activity_1v1cyre">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retroToolChoice != null and retroToolChoice != ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1fljfph" sourceRef="Activity_1v1cyre" targetRef="Activity_1ws6a1f" />
